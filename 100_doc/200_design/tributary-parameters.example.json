{
  "// Comment": "Tributary CLI Parameter Configuration",
  "// Description": "Copy this file to your project directory and rename to 'tributary-parameters.json' to override default settings",
  "// Usage": "These parameters can also be set via environment variables with TRIBUTARY_ prefix",

  "network": {
    "// defaultNetwork": "Default network for new projects (devnet/testnet/mainnet-beta)",
    "defaultNetwork": "devnet",

    "// timeout": "Network request timeout in milliseconds",
    "timeout": 30000,

    "// confirmationTimeout": "Transaction confirmation timeout in milliseconds",
    "confirmationTimeout": 60000,

    "// commitment": "Transaction commitment level (processed/confirmed/finalized)",
    "commitment": "confirmed"
  },

  "rpc": {
    "// endpoints": "Default RPC endpoints for each network",
    "endpoints": {
      "devnet": "https://api.devnet.solana.com",
      "testnet": "https://api.testnet.solana.com",
      "mainnet-beta": "https://api.mainnet-beta.solana.com"
    },

    "// fallbackEndpoints": "Backup RPC endpoints in case primary fails",
    "fallbackEndpoints": {
      "devnet": [
        "https://rpc.ankr.com/solana_devnet",
        "https://devnet.helius-rpc.com"
      ],
      "testnet": [
        "https://rpc.ankr.com/solana_testnet"
      ],
      "mainnet-beta": [
        "https://rpc.ankr.com/solana",
        "https://mainnet.helius-rpc.com"
      ]
    }
  },

  "snapshot": {
    "// defaultTiming": "Default snapshot timing (immediate or minutes ago)",
    "defaultTiming": "immediate",

    "// backupTiming": "Fallback timing in minutes when snapshot fails",
    "backupTiming": 3,

    "// maxRetryMinutes": "Maximum retry time range for snapshot acquisition",
    "maxRetryMinutes": 10,

    "// consistencyCheckEnabled": "Enable snapshot consistency validation",
    "consistencyCheckEnabled": true,

    "// maxTimeDriftSeconds": "Maximum acceptable time drift between snapshots",
    "maxTimeDriftSeconds": 60
  },

  "transaction": {
    "// batchSize": "Default number of transactions per batch (1-100)",
    "batchSize": 20,

    "// maxConcurrentBatches": "Maximum concurrent batches (1-10)",
    "maxConcurrentBatches": 3,

    "// estimatedGasPerTransaction": "Estimated SOL cost per transaction",
    "estimatedGasPerTransaction": 0.000005,

    "// estimatedTimePerBatchSeconds": "Estimated processing time per batch",
    "estimatedTimePerBatchSeconds": 2,

    "// batchDelayMs": "Delay between batches in milliseconds",
    "batchDelayMs": 100
  },

  "retry": {
    "// maxAttempts": "Maximum retry attempts (1-10)",
    "maxAttempts": 3,

    "// initialDelay": "Initial retry delay in seconds",
    "initialDelay": 1,

    "// backoffStrategy": "Backoff strategy (linear/exponential/fixed)",
    "backoffStrategy": "exponential",

    "// maxDelay": "Maximum delay between retries in seconds",
    "maxDelay": 30,

    "// timeoutSeconds": "Transaction timeout in seconds",
    "timeoutSeconds": 60
  },

  "distribution": {
    "riskThresholds": {
      "// largeAmountThreshold": "Distribution amount that triggers large amount warning",
      "largeAmountThreshold": 100000,

      "// largeRecipientCountThreshold": "Recipient count that triggers performance warning",
      "largeRecipientCountThreshold": 1000,

      "// smallAmountThreshold": "Individual amount that triggers small amount warning",
      "smallAmountThreshold": 0.001
    },

    "multiTokenWeighting": {
      "// defaultMethod": "Default weighting method (equal/tiered/proportional/custom)",
      "defaultMethod": "proportional",

      "// calculationBase": "Base for weight calculation (source_holdings/recipient_holdings)",
      "calculationBase": "recipient_holdings",

      "// normalizationMethod": "Weight normalization method (sum_to_one/max_to_one/none)",
      "normalizationMethod": "sum_to_one",

      "// minimumWeight": "Minimum weight value",
      "minimumWeight": 0.01,

      "// maximumWeight": "Maximum weight value",
      "maximumWeight": 0.80,

      "// tokens": "Default token configuration",
      "tokens": [
        {
          "mint": "So11111111111111111111111111111111111111112",
          "symbol": "SOL",
          "enabled": true
        },
        {
          "mint": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
          "symbol": "USDC",
          "enabled": true
        }
      ]
    },

    "multiWalletWeighting": {
      "// defaultMethod": "Default wallet weighting method (unweighted/custom/proportional)",
      "defaultMethod": "unweighted",

      "// maxWalletsPerUser": "Maximum wallets allowed per user",
      "maxWalletsPerUser": 10,

      "// minHoldingThreshold": "Minimum holding threshold for wallet inclusion",
      "minHoldingThreshold": 1.0,

      "// maxWeightPerUser": "Maximum weight per user to prevent concentration",
      "maxWeightPerUser": 1000000,

      "// userIdentification": "Method for identifying user wallet groups",
      "userIdentification": {
        "method": "manual_grouping",
        "autoDetection": false
      },

      "// unweightedConfig": "Configuration for unweighted method",
      "unweightedConfig": {
        "aggregationMethod": "simple_sum"
      },

      "// proportionalConfig": "Configuration for proportional method",
      "proportionalConfig": {
        "distributionType": "proportional",
        "calculationMethod": "logarithmic",
        "referenceMetric": "combined_ratio",
        "combinationRatio": {
          "baseTokenWeight": 0.6,
          "investmentTokenWeight": 0.4
        }
      }
    },

    "logic": {
      "// defaultType": "Default distribution type (fixed/tiered/proportional)",
      "defaultType": "proportional",

      "// defaultMethod": "Default calculation method (linear/logarithmic/square_root)",
      "defaultMethod": "linear",

      "// defaultPreset": "Default preset configuration",
      "defaultPreset": null,

      "// enableLimits": "Enable distribution limits by default",
      "enableLimits": false,

      "// defaultCap": "Default distribution cap",
      "defaultCap": null,

      "// defaultFloor": "Default distribution floor",
      "defaultFloor": null,

      "// tieredConfig": "Tiered distribution configuration",
      "tieredConfig": {
        "// enabled": "Enable tiered distribution",
        "enabled": false,

        "// boundaries": "Tier boundary values (token amounts)",
        "boundaries": [100, 1000, 10000],

        "// methods": "Calculation method for each tier",
        "methods": ["linear", "logarithmic", "square_root"],

        "// weights": "Weight multipliers for each tier",
        "weights": [1.0, 1.5, 2.0]
      },

      "// proportionalConfig": "Proportional distribution configuration",
      "proportionalConfig": {
        "// scalingFactor": "Scaling factor for proportional calculations",
        "scalingFactor": 1.0,

        "// minimumThreshold": "Minimum holding to qualify for distribution",
        "minimumThreshold": 0,

        "// logarithmicBase": "Base for logarithmic calculations (default: e)",
        "logarithmicBase": "e",

        "// squareRootPower": "Power for square root calculations (default: 0.5)",
        "squareRootPower": 0.5
      },

      "// fixedConfig": "Fixed distribution configuration",
      "fixedConfig": {
        "// amountPerRecipient": "Fixed amount per recipient (overrides total amount division)",
        "amountPerRecipient": null,

        "// excludeZeroBalances": "Exclude recipients with zero balance",
        "excludeZeroBalances": true,

        "// roundingMode": "Rounding mode for calculations (floor/ceil/round)",
        "roundingMode": "floor"
      },

      "// presetConfigurations": "Example preset configurations (for reference only - customize for your needs)",
      "presetConfigurations": {
        "example_1": {
          "type": "fixed",
          "method": null,
          "limits": { "cap": null, "floor": null },
          "fixedConfig": {
            "excludeZeroBalances": true,
            "roundingMode": "floor"
          }
        },
        "example_2": {
          "type": "proportional",
          "method": "linear",
          "limits": { "cap": null, "floor": null },
          "proportionalConfig": {
            "scalingFactor": 1.0,
            "minimumThreshold": 0
          }
        },
        "example_3": {
          "type": "tiered",
          "method": "logarithmic",
          "limits": { "cap": null, "floor": null },
          "tieredConfig": {
            "boundaries": [100, 1000, 10000],
            "methods": ["linear", "logarithmic", "square_root"],
            "weights": [1.0, 1.0, 1.0]
          }
        }
      }
    }
  },

  "token": {
    "// defaultDecimals": "Default decimal places for tokens",
    "defaultDecimals": 9,

    "// fallbackDecimals": "Fallback decimal places if detection fails",
    "fallbackDecimals": 6,

    "// minimumBalance": "Minimum balance required for distribution",
    "minimumBalance": 0
  },

  "cache": {
    "// defaultTtlSeconds": "Default cache time-to-live in seconds",
    "defaultTtlSeconds": 3600,

    "// walletCacheTtlSeconds": "Wallet data cache duration",
    "walletCacheTtlSeconds": 1800,

    "// configCacheTtlSeconds": "Configuration cache duration",
    "configCacheTtlSeconds": 300
  },

  "logging": {
    "// defaultLevel": "Default log level (error/warn/info/debug)",
    "defaultLevel": "info",

    "// defaultDir": "Default log directory",
    "defaultDir": "./logs",

    "// enableConsole": "Enable console logging",
    "enableConsole": true,

    "// enableFile": "Enable file logging",
    "enableFile": true,

    "// maxFiles": "Maximum number of log files to keep",
    "maxFiles": 14,

    "// maxFileSize": "Maximum size per log file",
    "maxFileSize": "20m"
  },

  "security": {
    "// defaultKeyEncryption": "Enable key encryption by default",
    "defaultKeyEncryption": true,

    "// defaultBackupEnabled": "Enable backup by default",
    "defaultBackupEnabled": true,

    "// defaultAuditLog": "Enable audit logging by default",
    "defaultAuditLog": true
  },

  "export": {
    "// defaultFormat": "Default export format (json/csv)",
    "defaultFormat": "json",

    "// fileNamePattern": "File naming pattern for exports",
    "// Available variables: {type}, {timestamp}, {format}",
    "fileNamePattern": "{type}_{timestamp}.{format}"
  },

  "validation": {
    "// maxRecipientsPerDistribution": "Maximum recipients allowed per distribution",
    "maxRecipientsPerDistribution": 10000,

    "// minBalanceForDistribution": "Minimum balance required to participate",
    "minBalanceForDistribution": 0.001,

    "// walletValidationTimeout": "Timeout for wallet validation in milliseconds",
    "walletValidationTimeout": 5000
  }
}